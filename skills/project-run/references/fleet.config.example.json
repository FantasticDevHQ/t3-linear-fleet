{
  "$comment": "Copy to ~/.config/t3-linear-fleet/config.json and edit. Keep it out of public repositories; it describes your own machines.",
  "maxWorkers": 5,
  "environments": [
    { "name": "local", "environmentId": null, "maxWorkers": 2, "localOnly": true },
    { "name": "cloud-1", "environmentId": "<T3 environment id from t3_environment_links>", "maxWorkers": 3 }
  ],
  "providers": {
    "prefer": ["claudeAgent", "codex", "antigravity"],
    "allowFastModelsForSimpleTickets": true
  },
  "budgets": {
    "fixCycles": 3,
    "ticketTimeMultiplier": 3,
    "takeovers": 1,
    "fixForwardMinutes": 45,
    "featureReviewRounds": 3
  },
  "integrationBranchPrefix": "feat/"
}
